# --- Database (Docker Compose Postgres on port 5433) ---
DATABASE_URL=postgresql+psycopg://lm_app:lm_secret_dev@localhost:5433/lm_inspection
# For a zero-setup demo you may use sqlite instead:
# DATABASE_URL=sqlite:///./lm_inspection.db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI pipeline (engine abstraction with demo mode) ---
# OCR engine: demo | tesseract | paddle
OCR_ENGINE=demo
# Field matcher: demo (deterministic) | ollama
FIELD_MATCHER=demo
# Only used when FIELD_MATCHER=ollama:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Storage ---
STORAGE_DIR=./data/storage
UPLOAD_MAX_MB=15

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
